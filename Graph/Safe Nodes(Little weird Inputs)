class Solution {
    public boolean dfs(int src,List<List<Integer>> temp,int vis[],int pathVis[],int []check){
        vis[src]=1;
        pathVis[src]=1;
        for(int it:temp.get(src)){
            if(vis[it]==0){
                if(dfs(it,temp,vis,pathVis,check)==true) return true;
            }else if(pathVis[it]==1) return true;
        }
        check[src]=1;
        pathVis[src]=0;
        return false;
    }
    public List<Integer> eventualSafeNodes(int[][] graph) {
        List<List<Integer>> temp = new ArrayList<>();
        int n = graph.length;
        for(int i=0;i<n;i++){
            temp.add(new ArrayList());
        }
        for(int u=0;u<n;u++){
            for(int v:graph[u]){
                temp.get(u).add(v);
            }
        }
        int vis[]=new int[n];
        int pathVis[] = new int[n];
        List<Integer> ans = new ArrayList<>();
        int check[]=new int[n];
        for(int i=0;i<n;i++){
            if(vis[i]==0){
                dfs(i,temp,vis,pathVis,check);
            }
        }
        for(int i=0;i<n;i++){
          if(check[i]==1) ans.add(i);  
        }
        return ans;
    }
}
