class Pair{
    int first;
    int second;
    public Pair(int first,int second){
        this.first=first;
        this.second=second;
    }
}
class Solution {

    public List<Integer> shortestPath(int n, int m, int[][] edges) {

        ArrayList<ArrayList<Pair>> adj = new ArrayList<>();

        for (int i = 0; i <= n; i++) {
            adj.add(new ArrayList<>());
        }

        // Build adjacency list
        for (int i = 0; i < m; i++) {

            adj.get(edges[i][0])
                .add(new Pair(edges[i][1], edges[i][2]));

            adj.get(edges[i][1])
                .add(new Pair(edges[i][0], edges[i][2]));
        }

        // Pair = {distance, node}
        PriorityQueue<Pair> pq =
            new PriorityQueue<>((a, b) -> a.first - b.first);

        pq.add(new Pair(0, 1));

        int[] parent = new int[n + 1];
        int[] distance = new int[n + 1];

        for (int i = 0; i <= n; i++) {
            distance[i] = Integer.MAX_VALUE;
            parent[i] = i;
        }

        distance[1] = 0;

        while (!pq.isEmpty()) {

            Pair p = pq.remove();

            int dis = p.first;
            int node = p.second;

            for (int i = 0; i < adj.get(node).size(); i++) {

                int adjNode = adj.get(node).get(i).first;
                int edgeWeight = adj.get(node).get(i).second;

                if (dis + edgeWeight < distance[adjNode]) {

                    distance[adjNode] = dis + edgeWeight;

                    pq.add(new Pair(dis + edgeWeight, adjNode));

                    parent[adjNode] = node;
                }
            }
        }

        // No path
        if (distance[n] == Integer.MAX_VALUE) {
            List<Integer> ans = new ArrayList<>();
            ans.add(-1);
            return ans;
        }

        List<Integer> ans = new ArrayList<>();

int node = n;

while (parent[node] != node) {
    ans.add(node);
    node = parent[node];
}

ans.add(1);

Collections.reverse(ans);

ans.add(0, distance[n]);

return ans;
    }
}
