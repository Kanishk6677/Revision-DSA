class Solution {
    public ArrayList<Integer> bellmanFord(int V, int[][] edges, int src) {

        int INF = 100000000;
        int dist[] = new int[V];

        Arrays.fill(dist, INF);

        // Source distance is 0
        dist[src] = 0;

        // Relax all edges V-1 times
        for(int i = 0; i < V - 1; i++) {

            for(int[] it : edges) {

                int u = it[0];
                int v = it[1];
                int wt = it[2];

                if(dist[u] != INF && dist[u] + wt < dist[v]) {
                    dist[v] = dist[u] + wt;
                }
            }
        }

        // Check for negative cycle
        for(int[] it : edges) {

            int u = it[0];
            int v = it[1];
            int wt = it[2];

            if(dist[u] != INF && dist[u] + wt < dist[v]) {
                ArrayList<Integer> ans = new ArrayList<>();
                ans.add(-1);
                return ans;
            }
        }

        // Convert int[] to ArrayList<Integer>
        ArrayList<Integer> ans = new ArrayList<>();

        for(int d : dist) {
            ans.add(d);
        }

        return ans;
    }
}
