class Pair {
    int first;
    int second;

    public Pair(int first, int second) {
        this.first = first;
        this.second = second;
    }
}

class Solution {

    public void bfs(int row, int col, boolean[][] vis, char[][] grid) {

        vis[row][col] = true;

        Queue<Pair> q = new LinkedList<Pair>();

        int n = grid.length;
        int m = grid[0].length;

        q.offer(new Pair(row, col));

        while (!q.isEmpty()) {

            Pair p = q.poll();

            int i = p.first;
            int j = p.second;
        int delrow[]={-1,0,1,0};
        int delcol[]={0,1,0,-1};
            for (int k = 0; k <4; k++) {

                    int nrow = i + delrow[k];
                    int ncol = j + delcol[k];

                    if (nrow >= 0 && nrow < n &&
                        ncol >= 0 && ncol < m &&
                        !vis[nrow][ncol] &&
                        grid[nrow][ncol] == '1') {

                        // ⭐ Mark when adding to queue
                        vis[nrow][ncol] = true;

                        q.offer(new Pair(nrow, ncol));
                    }
                
            }
        }
    }

    public int numIslands(char[][] grid) {

        int n = grid.length;
        int m = grid[0].length;

        boolean[][] vis = new boolean[n][m];

        int cnt = 0;

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < m; j++) {

                if (!vis[i][j] && grid[i][j] == '1') {

                    cnt++;

                    bfs(i, j, vis, grid);
                }
            }
        }

        return cnt;
    }
}
