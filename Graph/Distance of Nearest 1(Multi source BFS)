import java.util.ArrayList;
import java.util.*;

class Pair{
	int row;
	int col;
	int step;
	public Pair(int row,int col,int step){
		this.row=row;
		this.col=col;
		this.step=step;
	}
}
public class Solution {
	public static ArrayList<ArrayList<Integer>> nearest(ArrayList<ArrayList<Integer>> mat, int n, int m) {
		ArrayList<ArrayList<Integer>> dummy=mat;
		Queue<Pair> q = new LinkedList<>();
		int vis[][] =new int[n][m];
		for(int i=0;i<n;i++){
			for(int j=0;j<m;j++){
				if(dummy.get(i).get(j)==1){
					q.offer(new Pair(i,j,0));
					vis[i][j]=1;
				}
			}
		}
		int delrow[]={-1,0,1,0};
		int delcol[]={0,1,0,-1};
		while(!q.isEmpty()){
			Pair p = q.poll();
			int row=p.row;
			int col=p.col;
			int step=p.step;
			dummy.get(row).set(col,step);
			for(int i=0;i<4;i++){
				int nrow=row+delrow[i];
				int ncol=col+delcol[i];
				if(nrow>=0 && nrow<n && ncol>=0 && ncol<m && vis[nrow][ncol]==0){
					vis[nrow][ncol]=1;
					q.offer(new Pair(nrow,ncol,step+1));
				}
			}
		}
		return dummy;

	}
}
