class Solution {
    public void swap(int a,int b,int []nums){
        int temp=nums[a];
        nums[a]=nums[b];
        nums[b]=temp;
    }
    public void reverse(int i,int j,int []arr){
        while(i<j){
            swap(i,j,arr);
            i++;
            j--;
        }
    }
    public void nextPermutation(int[] nums) {
        int n =nums.length;
        int pivot=-1;
        for(int i=n-1;i>0;i--){
            if(nums[i]>nums[i-1]) {
                pivot=i-1;
                break;
            }
        }
        if(pivot==-1){
            reverse(0,n-1,nums);
            return;
        }
        for(int i=n-1;i>=0;i--){
            if(nums[i]>nums[pivot]){
                swap(i,pivot,nums);
                break;
            }
        }
       
             reverse(pivot+1,n-1,nums);
        
        
       
    }
}
