class Solution {
    public TreeNode insertIntoBST(TreeNode root, int val) {

        if (root == null) {
            return new TreeNode(val);
        }

        TreeNode prev = null;
        TreeNode curr = root;

        while (curr != null) {
            prev = curr;

            if (curr.val > val) {
                curr = curr.left;
            } else {
                curr = curr.right;
            }
        }

        TreeNode fresh = new TreeNode(val);

        if (prev.val > val) {
            prev.left = fresh;
        } else {
            prev.right = fresh;
        }

        return root;
    }
}
