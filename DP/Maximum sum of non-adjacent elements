Given an integer array nums of size n. Return the maximum sum possible using the elements of nums such that no two elements taken are adjacent in nums.




Example 1

Input: nums = [1, 2, 4]

Output: 5

Explanation:

[1, 2, 4], the underlin

class Solution {
    public int f(int idx,int []nums,int n,int [] dp){
        if(idx==0) return nums[idx];
        if(idx<0) return 0; 
        if(dp[idx]!=-1) return dp[idx];
        int pick=nums[idx]+f(idx-2,nums,n,dp);
        int np=0+f(idx-1,nums,n,dp);
        return dp[idx]=Math.max(pick,np);

    }
    public int nonAdjacent(int[] nums) {
        int n = nums.length;
        // int dp[] =new int[n];
        // Arrays.fill(dp,-1);
        // return f(n-1,nums,n,dp);

        // dp[0]=nums[0];
        int prev=nums[0];
        int prev2=0;
        
        for(int i =1;i<n;i++)
        {
            int pick = nums[i];if(i>1)pick+=prev2;
            int notpick=0+prev;
            int curri=Math.max(pick,notpick);
            prev2=prev;
            prev=curri;
        }
        // return dp[n-1];
        return prev;


    }
}
