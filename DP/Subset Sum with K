import java.util.* ;
import java.io.*; 
public class Solution {
    public static boolean f(int idx,int target,int arr[],int dp[][]){
        if(target==0) return true;
        if(idx==0) return (target==arr[idx]);

       if(dp[idx][target]!=-1) return dp[idx][target]==1;
        boolean notPick=f(idx-1,target,arr,dp);
        boolean  pick = false;
        if(target>=arr[idx])pick = f(idx-1,target-arr[idx],arr,dp);
        boolean ans = pick||notPick;
        dp[idx][target]=ans?1:0;
        return ans;
    }
    public static boolean subsetSumToK(int n, int target, int arr[]){
        boolean  dp[][]=new boolean [n][target+1];
        // for(int []dps:dp){
        //     Arrays.fill(dps,-1);
        // }
        for(int i=0;i<n;i++){
            dp[i][0]=true;
        }
        if(target>=arr[0]) dp[0][arr[0]]=true;

        for(int i=1;i<n;i++){
            for(int j=1;j<=target;j++){
                
                boolean notTake=dp[i-1][j];
                boolean take = false;
                if(arr[i]<=j) take=dp[i-1][j-arr[i]];
                dp[i][j]=take||notTake;
            }
        }

        return dp[n-1][target];
    }
}
