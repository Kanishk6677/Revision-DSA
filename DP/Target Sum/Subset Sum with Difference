import java.util.*;

public class Solution {

    public static int f(int idx, int target, int[] arr, int[][] dp) {

        // Base case
        if (idx == 0) {

            // arr[0] = 0 and target = 0
            // We have two choices: +0 or -0
            if (target == 0 && arr[0] == 0) {
                return 2;
            }

            // Either don't pick arr[0]
            // or pick arr[0]
            if (target == 0 || target == arr[0]) {
                return 1;
            }

            return 0;
        }

        // Already calculated
        if (dp[idx][target] != -1) {
            return dp[idx][target];
        }

        // Pick
        int pick = 0;

        if (target >= arr[idx]) {
            pick = f(idx - 1, target - arr[idx], arr, dp);
        }

        // Don't pick
        int notPick = f(idx - 1, target, arr, dp);

        // Total number of ways
        return dp[idx][target] = pick + notPick;
    }

    public static int findWays(int n, int target, int[] arr) {

        int[][] dp = new int[n][target + 1];

        for (int[] row : dp) {
            Arrays.fill(row, -1);
        }

        return f(n - 1, target, arr, dp);
    }

    public static int countPartitions(int n, int target, int[] arr) {

        int totalSum = 0;

        for (int i = 0; i < n; i++) {
            totalSum += arr[i];
        }

        // Impossible cases
        if (totalSum - target < 0 ||
            (totalSum - target) % 2 != 0) {
            return 0;
        }

        // S2 = (totalSum - target) / 2
        int required = (totalSum - target) / 2;

        return findWays(n, required, arr);
    }

    public static int targetSum(int n, int target, int[] arr) {
        return countPartitions(n, target, arr);
    }
}
