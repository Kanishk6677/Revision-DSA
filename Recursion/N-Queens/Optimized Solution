class Solution {
    public boolean isSafe(int row,int col,char [][] board){
        int drow=row;
        int dcol=col;
        int n =board.length;
        // up
        while(row>=0){
            if(board[row][col]=='Q') return false;
            row--;
        }
        row=drow;
        col=dcol;
        // left up diagonal
        while(row>=0 && col>=0){
            if(board[row][col]=='Q') return false;
            row--;
            col--;
        }
        row=drow;
        col=dcol;
        // left same row
        while(col>=0){
             if(board[row][col]=='Q') return false;
            
            col--;
        }
        // lower diagonal left
        row = drow;
        col = dcol;
        while (row < n && col >= 0) {
            if (board[row][col] == 'Q') return false;
            row++;
            col--;
        }
        return true;


    }
    public void f(int col,char [][] board , List<List<String>> ans){
        int n= board.length;
        if(col==n){
            List<String>temp = new ArrayList<>();
            for(char []row:board){
                temp.add(new String(row));
            }
            ans.add(temp);
            return;
        }
        for(int i=0;i<n;i++){
            if(isSafe(i,col,board)){
                board[i][col]='Q';
                f(col+1,board,ans);
                board[i][col]='.';
            }
        }
    }
    public List<List<String>> solveNQueens(int n) {
        List<List<String>> ans = new ArrayList<>();
        char [][] board = new char[n][n];
        for(int i=0;i<n;i++){
            Arrays.fill(board[i],'.');
        }
        f(0,board,ans);
        return ans;
    }
}
